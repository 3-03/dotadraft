# Скопируй этот файл в .env и вставь свой токен от @BotFather
BOT_TOKEN=123456789:AA...your_token_here

# HTTPS-ссылка на размещённый Mini App (папка webapp/).
# Например, GitHub Pages: https://ТВОЙ_ЛОГИН.github.io/dota-draft-bot/
# Если оставить пустым — бот работает только в текстовом режиме.
WEBAPP_URL=
